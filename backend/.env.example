# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Disaster_Management
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-min-256-bits-long-example-key-12345678901234567890

# Server Configuration
PORT=8080
SHOW_SQL=false
LOG_LEVEL=INFO

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# SMS/WhatsApp Configuration (Twilio)
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# OTP Configuration
OTP_ENABLED=true
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Email Configuration (if implementing email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@localproblems.in
